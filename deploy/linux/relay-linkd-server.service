[Unit]
Description=Relay Link server backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=relay-link
Group=relay-link
WorkingDirectory=/usr/local/bin
RuntimeDirectory=relay-link
RuntimeDirectoryMode=0770
ExecStart=/usr/local/bin/relay-linkd server
Restart=on-failure
RestartSec=5
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/usr/local/bin/config /usr/local/bin/log /run/relay-link

[Install]
WantedBy=multi-user.target
