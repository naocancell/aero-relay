#!/bin/sh
set -eu

case "${1:-}" in
    remove|deconfigure)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl disable --now relay-linkd-server.service >/dev/null 2>&1 || true
            systemctl disable --now relay-linkd-relay.service >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
