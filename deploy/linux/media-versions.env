# Linux media dependencies bundled by the Ubuntu package.
# FFmpeg is built from the official source release because the FFmpeg project
# publishes source releases and the available prebuilt Linux snapshot is not
# the same version as the Windows package.
FFMPEG_VERSION=9.0.1
FFMPEG_SOURCE_ARCHIVE_NAME=ffmpeg-9.0.1.tar.xz
FFMPEG_SOURCE_ARCHIVE_URL=https://ffmpeg.org/releases/ffmpeg-9.0.1.tar.xz
FFMPEG_SOURCE_ARCHIVE_SHA256=cf38e0e28c7e5605942c4a77755349b0145804a397af37eb1fb4c77cb237f635

MEDIAMTX_VERSION=v1.18.2

target_arch_detected="${TARGET_ARCH:-$(dpkg --print-architecture 2>/dev/null || uname -m)}"
case "$target_arch_detected" in
  arm64|aarch64)
    MEDIAMTX_ARCHIVE_NAME="mediamtx_${MEDIAMTX_VERSION}_linux_arm64.tar.gz"
    MEDIAMTX_ARCHIVE_URL="https://github.com/bluenviron/mediamtx/releases/download/${MEDIAMTX_VERSION}/mediamtx_${MEDIAMTX_VERSION}_linux_arm64.tar.gz"
    MEDIAMTX_ARCHIVE_SHA256="c78aa7a1bdab94b2b02be364661f17802143215dba37e1fa67c3e0849248b485"
    ;;
  *)
    MEDIAMTX_ARCHIVE_NAME="mediamtx_${MEDIAMTX_VERSION}_linux_amd64.tar.gz"
    MEDIAMTX_ARCHIVE_URL="https://github.com/bluenviron/mediamtx/releases/download/${MEDIAMTX_VERSION}/mediamtx_${MEDIAMTX_VERSION}_linux_amd64.tar.gz"
    MEDIAMTX_ARCHIVE_SHA256="73ed27c292e05ceb4990dcb34531f01872dfff5374b7515c45a202e0abf47706"
    ;;
esac
